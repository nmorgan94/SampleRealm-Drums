<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Snap Snare" category="Snappy" type="Snare" author="SampleRealm" formatVersion="1">
  <Parameters>
    <PARAM id="instrument" value="1"/>
    <PARAM id="snareBodyLevel" value="-2.0"/>
    <PARAM id="snareNoiseLevel" value="-8.0"/>
    <PARAM id="snareNoiseLowCut" value="2000.0"/>
    <PARAM id="snareSnapType" value="2"/>
    <PARAM id="snareSnapLevel" value="0.0"/>
    <PARAM id="snareSnapTone" value="5000.0"/>
    <PARAM id="snareSnapDecay" value="5.0"/>
    <ENVELOPES>
      <ENV id="snarePitch">
        <NODE t="0.0" v="900.0" c="0.0"/>
        <NODE t="0.004" v="450.0" c="0.5"/>
        <NODE t="0.02" v="400.0" c="0.0"/>
      </ENV>
      <ENV id="snareBody">
        <NODE t="0.0" v="1.0" c="0.0"/>
        <NODE t="0.002" v="1.0" c="0.0"/>
        <NODE t="0.05" v="0.0" c="0.6"/>
      </ENV>
      <ENV id="snareNoise">
        <NODE t="0.0" v="1.0" c="0.0"/>
        <NODE t="0.04" v="0.0" c="0.5"/>
      </ENV>
    </ENVELOPES>
  </Parameters>
</PRESET>
